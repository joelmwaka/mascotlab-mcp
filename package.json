    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joelmwaka/mascotlab-mcp.git"
  },
  "homepage": "https://mascotlab.io",
  "keywords": [
    "mcp",
    "model-context-protocol",
